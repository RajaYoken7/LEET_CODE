class Solution(object):
    def missingInteger(self, nums):
        unequal_index=0
        if(len(nums)==1):
            return nums[0]+1
        for i in range(1,len(nums)):
            if(nums[i]!=nums[i-1]+1):
                unequal_index=i
                break
        if unequal_index==0:
            return sum(nums)
        result = sum(nums[:unequal_index])
               
        return self.check_exists(result,nums)
    def check_exists(self,result,nums):
        while(result in nums):
            result=result+1            
        else:
            return result
